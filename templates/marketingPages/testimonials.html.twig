{% extends "base.html.twig" %}

{% block header %}
	{% if app.user %}
		{% include "partials/user-header.html.twig" %}
	{% else %}

		{% include "partials/visitor-header.html.twig" %}
	{% endif %}
{% endblock %}
{% block body %}
	<main id="testimonials">
    <h1>Testimonials</h1>
		{% if app.user %}
			<div class="new-testimonial">
				<a href="{{path('testimonial_new')}}" class="btn">Leave a Testimonial</a>
			</div>
		{% endif %}

		{% for testimonial in testimonials %}
			<div class="testimonial-card">
				<p class="testimonial-quote">"{{ testimonial.content }}"</p>
				<p class="testimonial-name">—
					{{ testimonial.firstName }}
					~
					<span>{{testimonial.name}}</span>
				</p>
			</div>
		{% else %}
			<p>No testimonials yet. Be the first to share your experience!</p>
		{% endfor %}

	</main>
{% endblock %}

{% block footer %}
	{% include "partials/footer.html.twig" %}
{% endblock %}
