{% extends "base.html.twig" %}
{% block header %}
	{% include "partials/visitor-header.html.twig" %}
{% endblock %}
{% block body %}
	<section class="hero">
		<h1>WELCOME TO EASY PEASY FRANCE!</h1>
		<p>Navigating life in France has never been easier. Our platform simplifies your administrative tasks, making your transition smoother.</p>
		<p class'free-phrase'><i>Completely free and designed to support newcomers in France.</i></p>
		<div class="buttons">
			<a href="{{path('app_login')}}" class="pri-btn">Get Started</a>
			<a href="{{path('about')}}" class="sec-btn" style="background-color:#A8A69F;">Learn More</a>
		</div>
	</section>
	<main id="home">
		<section id='features'>
			<h2 class="section-title">Explore Our Essential Features For You</h2>
			<div class="features">
				<div class="feature-card">
					<h3>Personalized Administrative Guide</h3>
					<p>Access a clear, step-by-step guide based on your situation 'student, worker, family, or refugee'. Each step explains what to do, where to go, and provides links to official French websites.</p>
				</div>
				<div class="feature-card">
					<h3>Appointment Booking</h3>
					<p>Book an appointment with our NGO team to get further help when needed. Our team can guide you through specific administrative steps and answer your questions.</p>
				</div>
				<div class="feature-card">
					<h3>Community Help Space</h3>
					<p>Ask questions, share your experience, and get advice from other newcomers. The community is a safe and supportive space no judgment, just help and solidarity.</p>
				</div>
				<div class="feature-card">
					<h3>Secure & Private Platform</h3>
					<p>Your personal data is safe we do not store or request your documents. You stay in full control of your information at all times.</p>
				</div>
			</div>
		</section>
		<section id='how-it-works'>
			<h2 class="section-title">Discover How Easy Peasy France Works</h2>
			<p style="text-align:center;">Navigating your new life in France can be overwhelming. Easy Peasy France simplifies the process with a straightforward approach.</p>
			<div class="steps">
				<div class="step">
					<h3>Step 1: Create your account</h3>
					<p>Select your profile and start your journey with us.</p>
				</div>
				<div class="step">
					<h3>Step 2: Get your guide to-do list</h3>
					<p>Receive a guide to dos based on your situation and profile.</p>
				</div>
				<div class="step">
					<h3>Step 3: Access support</h3>
					<p>Book appointments with the association, and ask questions to other users as well as reply to questions asked by other users as well.</p>
				</div>
			</div>
			<div class="buttons" style="margin-top:2rem; text-align:center;">
				<a href="{{path('app_login')}}" class="pri-btn">Start Now</a>
				<a href="{{path('about')}}" class="sec-btn" style="background-color:#A8A69F;">Learn More</a>
			</div>
		</section>
		<section id='profiles'>
			<h2 class="section-title">Discover The Diverse User Profiles We Support</h2>
			<div class="profiles">
				<div class="profile">
					<h3>Family Visa</h3>
					<p>Support for residence permits, healthcare, banking, and more.</p>
				</div>
				<div class="profile">
					<h3>International Students</h3>
					<p>Help with visas, enrolment, accommodation, and student life.</p>
				</div>
				<div class="profile">
					<h3>Asylum Seekers</h3>
					<p>Guidance on legal procedures, housing, rights, and services.</p>
				</div>
				<div class="profile">
					<h3>Work Visa</h3>
					<p>Integration support, from job search to social services.</p>
				</div>
			</div>
		</section>
	</main>
{% endblock %}

{% block footer %}
	{% include "partials/footer.html.twig" %}
{% endblock %}
