{% extends "base.html.twig" %}
{% block header %}
	{% include "partials/visitor-header.html.twig" %}
{% endblock %}
{% block body %}
	<section class="hero">
		<h1>WELCOME TO EASY PEASY FRANCE!</h1>
		<p>Navigating life in France has never been easier. Our platform simplifies your administrative tasks, making your transition smoother.</p>
		<div class="buttons">
			<a class="btn">Get Started</a>
			<a href="{{path('about')}}" class="sec-btn" style="background-color:#A8A69F;">Learn More</a>
		</div>
	</section>
	<main id="home">


		<section id='features'>
			<h2 class="section-title">Explore Our Essential Features For You</h2>
			<div class="features">
				<div class="feature-card">
					<h3>Streamlined To-Do List System</h3>
					<p>Stay organized with a simple, profile-tailored to-do list. Track your progress, mark tasks as complete, and stay on top of deadlines with built-in reminders.</p>
				</div>
				<div class="feature-card">
					<h3>Secure Document Storage</h3>
					<p>Safely store and organize your important documents in one place. Access them anytime, with encryption ensuring your sensitive information is protected.</p>
				</div>
				<div class="feature-card">
					<h3>Supportive Community Help</h3>
					<p>Ask questions, share tips, and get real answers from people who’ve been through the same steps. Browse posts by topic or profile, save helpful advice, and join a safe space made for newcomers.</p>
				</div>
				<div class="feature-card">
					<h3>Multilingual & Profile-Based Support</h3>
					<p>Get assistance in your preferred language. Our platform adapts to your profile and needs to ensure you receive the right support every step of the way.</p>
				</div>
			</div>
		</section>
		<section id='how-it-works'>
			<h2 class="section-title">Discover How Easy Peasy France Works</h2>
			<p style="text-align:center;">Navigating your new life in France can be overwhelming. Easy Peasy France simplifies the process with a straightforward approach.</p>
			<div class="steps">
				<div class="step">
					<h3>Step 1: Create your account</h3>
					<p>Select your profile and start your journey with us.</p>
				</div>
				<div class="step">
					<h3>Step 2: Get your to-do list</h3>
					<p>Receive a checklist based on your situation and profile.</p>
				</div>
				<div class="step">
					<h3>Step 3: Track progress & access support</h3>
					<p>Mark tasks complete, upload documents, book appointments, and chat with support when needed.</p>
				</div>
			</div>
			<div class="buttons" style="margin-top:2rem; text-align:center;">
				<a class="btn">Start Now</a>
				<a href="#" class="sec-btn" style="background-color:#A8A69F;">Learn More</a>
			</div>
		</section>
		<section id='profiles'>
			<h2 class="section-title">Discover The Diverse User Profiles We Support</h2>
			<div class="profiles">
				<div class="profile">
					<h3>Immigrants / Expatriates</h3>
					<p>Support for residence permits, healthcare, banking, and more.</p>
				</div>
				<div class="profile">
					<h3>International Students</h3>
					<p>Help with visas, enrolment, accommodation, and student life.</p>
				</div>
				<div class="profile">
					<h3>Asylum Seekers</h3>
					<p>Guidance on legal procedures, housing, rights, and services.</p>
				</div>
				<div class="profile">
					<h3>Refugees</h3>
					<p>Integration support, from job search to social services.</p>
				</div>
			</div>
		</section>
	</main>
{% endblock %}

{% block footer %}
	{% include "partials/footer.html.twig" %}
{% endblock %}
