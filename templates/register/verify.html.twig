{% extends 'base.html.twig' %}

{% block body %}
    <main id="verify-account">
        <div class="form-container">
            <h1>Verify your account</h1>
            <p class='small'><i>The code is valide for 15 minutes. Check your spams too</i></p>

            {% if error %}
                <p class="error">{{ error }}</p>
            {% endif %}

            <form method="post">
                <label for="verification_code">Enter the verification code sent to your email:</label>
                <input type="text" id="verification_code" name="verification_code" required maxlength="6" />
                <button type="submit" class='btn-login'>Verify</button>
            </form>
        </div>
    </main>
{% endblock %}
