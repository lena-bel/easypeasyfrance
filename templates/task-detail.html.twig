{% extends "base.html.twig" %}
{% block header %}
	{% include "partials/user-header.html.twig" %}
{% endblock %}
{% block body %}
	<main id="task-details">
		<a href="{{ path('task_index') }}" class="back-btn">&larr; Go back</a>
		<h1>{{ task.title }}</h1>
		<div class="card">
			<p>{{task.informationalMessage}}</p>
		</div>
		<section id="steps">
			<h2>Step-by-step Instructions</h2>
			<div class="details">
				{% for step in steps %}
					<p>
						<input type="checkbox" id="step-{{ loop.index }}" name="step-{{ loop.index }}">
						<label for="step-{{ loop.index }}">{{ step.step }}</label>
					</p>
				{% endfor %}
			</div>
		</section>
		<section id="documents">
			<h2>Documents Required</h2>
			{% for document in documents %}
				<div class="documents details">
					<p>{{ document.name }}</p>
				</div>
			{% endfor %}
		</section>

		<section id="appointment">
			<h2>Appointment Information</h2>
			<div class="details">
				<p>{{task.appointmentNote}}</p>
				{% if task.appointmentLink is defined %}
					<a href="{{task.appointmentLink}}" target="_blank">
						{{task.appointmentLink}}
					</a>
				{% endif %}

				{% if links %}
					<p>
						<i>Other Links that might help you:</i>
					</p>
					{% for link in links %}
						<a href="{{ link.link }}" target="_blank">{{ link.link}}</a><br>
					{% endfor %}
				{% endif %}
			</div>


		</section>
	</main>

{% endblock %}
