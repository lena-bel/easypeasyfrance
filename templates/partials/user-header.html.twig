<nav class="header">
<div id="logo">
	<a href="{{ path('task_index') }}" class="logo">Easy Peasy France</a>

</div>
<div class="links">
	<a href="{{ path('task_index') }}">To-Do</a>
	<a href="#">Messages</a>
	<a href="{{ path('posts_index') }}">Community Help</a>
