{% extends "base.html.twig" %}
{% block header %}
	{% include "partials/user-header.html.twig" %}
{% endblock %}

{% block body %}
	<main id="my-posts">
		<h1>My Posts</h1>
		<div class="tabs">
			<button class="tab-link active buttons" data-tab="posts">My Posts</button>
			<button class="tab-link buttons" data-tab="favorites">My Favorites</button>
		</div>
		<section class="my-posts tab-content active" id='posts'>
			{% if posts|length == 0 %}
				<p>You haven’t created any posts yet.</p>
			{% else %}
				<table>
					<thead>
						<tr>
							<th>Title</th>
							<th>Posted At</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						{% for post in posts %}
							<tr>
								<td>{{ post.title }}</td>
								<td>{{ post.creationDate ? post.creationDate|date('d/m/Y ') : 'N/A' }}</td>
								<td class='action'>
									<a href="{{ path('post_detail', {id: post.id}) }}">View</a>
									<span>|</span>
									<form method="post" action="{{ path('post_delete', {id: post.id}) }}" style="display:inline" onsubmit="return confirm('Are you sure?');">
										<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
										<button type="submit" class='delete-btn'>Delete</button>
									</form>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			{% endif %}
		</section>
		<section class="favorite-posts tab-content" id='favorites'>
			{% if favoritePosts|length > 0 %}
				<ul class="posts-list">
					{% for post in favoritePosts %}
						<li>
							<h3  class="post-title">
								<a href="{{ path('post_detail', {id: post.id}) }}">{{ post.title }}</a>
							</h3>
							<p>{{ post.content|slice(0, 100) ~ '...' }}</p>

                            <div class="post-meta" data-date="{{ post.publicationDate|date('c') }}">
							<p>By{{post.user.firstName}}
								<span>-</span>
								<span class="time-ago"></span>
								<span>-</span>
								<a href="{{ path('post_detail', {id: post.id}) }}">{{post.commentsNumber}}
									comments
								</a>
								<span>-</span>
								<a href="{{ path('post_favorite', {id: post.id}) }}" class="favorite-btn">
								{% if app.user.favoritePosts.contains(post) %}
									<i class="fa-solid fa-heart favorite-icon" style="color: #C66B3D; font-size: 20px;"></i>
								{% else %}
									<i class="fa-regular fa-heart favorite-icon" style="color: black; font-size: 20px;"></i>
								{% endif %}
							</a>
							</p>
							

						</div>

						</li>
					{% endfor %}
				</ul>
			{% else %}
				<p>You haven’t favorited any posts yet.</p>
			{% endif %}
		</section>

	</main>
<script>
document.addEventListener("turbo:load", function() {
 document.querySelectorAll('.tab-link').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.tab-link').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(tc => tc.classList.remove('active'));

            btn.classList.add('active');
            document.getElementById(btn.dataset.tab).classList.add('active');
        });
    });
})
</script>
    

{% endblock %}


{% block footer %}
	{% include "partials/footer.html.twig" %}
{% endblock %}
