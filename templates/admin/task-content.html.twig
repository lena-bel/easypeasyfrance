{% extends "base.html.twig" %}
{% block header %}
	{% include "partials/admin-header.html.twig" %}
{% endblock %}
{% block body %}
	<main id="task-content">
		<h1>Tasks & Content</h1>
		<form class="search" method="get" action="">
			<input name="search" type="text" placeholder="Search tasks..." class="search-bar"/>
			<a href="{{ path('admin_task_new') }}" class="button-clear">+ New Task</a>
		</form>
		<div class="table-container">
			<table>
				<thead>
					<tr>
						<th>Title</th>
						<th>Profiles</th>
						<th>Status</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for task in tasks %}
						<tr>
							<td>{{ task.title }}</td>

							<td>
								{% if task.visaType is not empty %}
									{% for profile in task.visaType %}
										<span class="tag">{{ profile.name }}
										</span>
										<br>
									{% endfor %}
								{% else %}
									<em>No profiles linked</em>
								{% endif %}
							</td>

							<td>{{ task.updatedAt|date('d M Y') }}</td>

							<td class="action">
								<a href="{{path('task_details', {'id': task.id})}}">Steps</a>
								<a href="{{path('admin_task_edit', {'id': task.id})}}">Edit</a>
								<form id="delete-task-{{ task.id }}" action="{{path('delete-task',{'id':task.id})}}" method="POST" style="display:none">
									<input type="hidden" name="_token" value="{{csrf_token('delete'~ task.id)}}">
								</form>
								<a href="#" onclick="event.preventDefault(); if(confirm('Are you sure you want to delete this task?')) { document.getElementById('delete-task-{{ task.id }}').submit(); }" style="color: red;">Delete</a>
							</td>
						</tr>
					{% endfor %}
				</tbody>

			</table>
		</div>
	</main>
{% endblock %}