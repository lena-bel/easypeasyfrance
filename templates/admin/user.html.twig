{% extends "base.html.twig" %}
{% block body %}
	<main id="users">
		<h1>Users</h1>
		<form class="search" method="get" action="{{ path('users') }}">
			<input name="search" type="text" placeholder="Search users..." class="search-bar"/>
			<a href="{{ path('users') }}" class="button-clear">Show All</a>
		</form>
		<div class="table-container">
			<table>
				<thead>
					<tr>
						<th>Name</th>
						<th>Email</th>
						<th>Profile</th>
						<th>Status</th>
						<th>Registered</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for user in users %}
						<tr>
							<td>
								{{user.firstName}}
								{{user.lastName}}
							</td>
							<td>
								{{user.email}}
							</td>
							<td>{{user.profile.name}}</td>
							{% if user.isActive == 1 %}
							<td class="active">Active</td>
							{% else %}
								<td class="inactive">Inactive</td>
							{% endif %}
							
							
							<td> {{user.registryDate|date('d M Y')}} </td>
							{#can't add date without converting it to string #}
							<td>
								<a>View</a>
								<a href="{{ path('user_edit', {'id': user.id}) }}">Edit</a>
								<a class="deactivate">Deactivate</a>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</main>
{% endblock %}
