{% extends "base.html.twig" %}
{% block header %}
	{% include "partials/admin-header.html.twig" %}
{% endblock %}
{% block body %}
	<main id="users">
		<h1>Users</h1>
		<form class="search" method="get" action="{{ path('users') }}">
			<input name="search" type="text" placeholder="Search users..." class="search-bar"/>
			<a href="{{ path('users') }}" class="button-clear">Show All</a>
		</form>
		<div class="table-container">
			<table>
				<thead>
					<tr>
						<th>Name</th>
						<th>Email</th>
						<th>Telephone</th>
						<th>Profile</th>
						<th>Status</th>
						<th>Registered</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for user in users %}
						{% if not user.isAdmin %}
							<tr>
								<td>
									{{user.firstName}}
									{{user.lastName}}
								</td>
								<td>
									{{user.email}}
								</td>
								<td>
									{{user.telephoneNumber}}
								</td>
								<td>{{user.profile.name}}</td>
								{% if user.isActive == 1 %}
									<td class="active">Active</td>
								{% else %}
									<td class="inactive">Inactive</td>
								{% endif %}


								<td>
									{{user.registryDate|date('d M Y')}}
								</td>
								<td>
									<a href="{{ path('user_edit', {'id': user.id}) }}">
										Edit</a>
									{% if user.isActive %}
										<a href="{{ path('user_toggle_status', { id: user.id }) }}" class="deactivate">Deactivate</a>
									{% else %}
										<a href="{{ path('user_toggle_status', { id: user.id }) }}" class="active">Activate</a>
									{% endif %}
									


								</td>
							</tr>
						{% endif %}

					{% endfor %}
				</tbody>
			</table>
		</div>
	</main>
{% endblock %}
