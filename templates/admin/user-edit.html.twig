{% extends "base.html.twig" %}
{% block body %}
	<main id="user-edit">
		<a href="{{ path('users') }}" class="back-btn">Go back</a>
		<h1>User edit</h1>
		{# <pre>{{ dump(form) }}</pre> #}
		{{ form_start(form) }}
		<div class="form-group">
			{{ form_label(form.firstName) }}
			{{ form_widget(form.firstName, {'attr': {'class': 'form-control'}}) }}
			{{ form_errors(form.firstName) }}
		</div>

		<div class="form-group">
			{{ form_label(form.lastName) }}
			{{ form_widget(form.lastName, {'attr': {'class': 'form-control'}}) }}
			{{ form_errors(form.lastName) }}
		</div>

		<div class="form-group">
			{{ form_label(form.email) }}
			{{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
			{{ form_errors(form.email) }}
		</div>

		<div class="form-group">
			{{ form_label(form.telephoneNumber) }}
			{{ form_widget(form.telephoneNumber, {'attr': {'class': 'form-control'}}) }}
			{{ form_errors(form.telephoneNumber) }}
		</div>


		<div class="form-group">
			{{ form_label(form.roles) }}
			{{ form_widget(form.roles, {'attr': {'class': 'roles-flex'}}) }}
			{{ form_errors(form.roles) }}
		</div>
		<div class="form-group">
			{{ form_label(form.profile) }}
			{{ form_widget(form.profile, {'attr': {'class': 'form-control'}}) }}
			{{ form_errors(form.profile) }}
		</div>

		<div class="form-group">
			{{ form_widget(form.save, {'attr': {'class': 'btn-save'}}) }}
			{{ form_errors(form.profile) }}
		</div>
		{{ form_end(form) }}

	</main>
{% endblock %}
