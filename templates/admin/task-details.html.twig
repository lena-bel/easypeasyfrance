{% extends 'base.html.twig' %}
{% block header %}
	{% include "partials/admin-header.html.twig" %}
{% endblock %}
{% block body %}
	<main id="admin-task-detail">
		<a href="{{ path('task-content') }}" class="back-btn">&larr; Back to Tasks</a>
		<h1>Task:
			{{ task.title }}</h1>
		{# <p>{{task.description}}</p> #}

		<div class="task-detail">
			<div class="block">
				<h2>Description</h2>
				<p>{{ task.description }}</p>
			</div>

			<div class="block">
				<h2>Appointment Note</h2>
				<p>{{ task.appointmentNote }}</p>
			</div>

			<div class="block">
				<h2>Appointment Link</h2>
				{% if task.appointmentLink is defined %}
					<a href="{{task.appointmentLink}}" target="_blank">
						{{task.appointmentLink}}
					</a>
				{% endif %}
			</div>

			<div class="block">
				<h2>Informational Message</h2>
				<p>{{ task.informationalMessage }}</p>
			</div>

			<div class="block">
			{% if externalLinks is defined %}
				<h2>External Links</h2>
				<ul>
					
						<p>
							<i>Other Links that might help you:</i>
						</p>
						{% for externalLink in externalLinks %}
							
								<a href="{{externalLink}}" target="_blank">{{externalLink}}
								</a>
								<br>
						{% endfor %}

					
				</ul>
			{% endif %}
			</div>

			<div class="block">
				<h2>Document Checklist</h2>
				
					<div class="documents details">
						{% for document in documents %}
							<p>{{ document.name }}
						{% endfor %}
						
					</div>
				
			</div>

			<div class="block">
				<h2>Steps</h2>
				<div class="steps">
					{% for step in steps %}
					<p>

						{{ step.step }}
					</p>
				{% endfor %}
				</div>
			</div>

		</div>
	</main>
{% endblock %}
