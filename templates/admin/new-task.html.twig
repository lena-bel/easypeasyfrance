{% extends "base.html.twig" %}
{% block header %}
	{% include "partials/admin-header.html.twig" %}
{% endblock %}

{% block body %}
	<main id="form">
		<a href="{{ path('task-content') }}" class="back-btn">&larr; Go back</a>
		<div class="task-form">
			{{ form_start(form) }}

			{{ form_row(form.title) }}
			{{ form_row(form.description) }}
			{{ form_row(form.appointmentNote) }}
			{{ form_row(form.appointmentLink) }}
			{{ form_row(form.informationalMessage) }}
			{{ form_row(form.visaType) }}

			<!-- Steps Collection -->
			<div class="task">
				<div class="title-button">
					<h3>Steps</h3>
					<button type="button" id="add-step" class="btn">+ Add Step</button>

				</div>
				<div class="collection-steps" data-prototype="{{ form_widget(form.steps.vars.prototype)|e('html_attr') }}">
					{{ form_widget(form.steps) }}
				</div>
			</div>
			<div class="task">
				<div class="title-button">
					<h3>Required Documents</h3>

					<button type="button" class="btn" id="add-document">+ Add Document</button>
				</div>
				<div class="collection-documents" data-prototype="{{ form_widget(form.documents.vars.prototype)|e('html_attr') }}">
					{{ form_widget(form.documents) }}
				</div>
			</div>
			<div class="task">
				<div class="title-button">
					<h3>Helpful Links</h3>

					<button type="button" class="btn" id="add-link">+ Add Link</button>
				</div>
				<div class="collection-links" data-prototype="{{ form_widget(form.links.vars.prototype)|e('html_attr') }}">
					{{ form_widget(form.links) }}
				</div>
			</div>

			{{ form_rest(form) }}
			{{ form_end(form) }}
		</div>

	</main>

	<script>
	//this unction adds a new form element to the symfony element (steps, documents, links)
		function addForm(buttonSelector, containerSelector) {
			// here i am adding a click listener to my buttons 
			document.querySelector(buttonSelector).addEventListener('click', function (e) {
				e.preventDefault();
				//The container holds all collection items (steps, links, documents)
				const container = document.querySelector(containerSelector);
				// Symfony stores the HTML prototype of a collection as a data attribute
				const prototype = container.dataset.prototype;
				//Each new form needs a unique index for field names
				const index = container.children.length;
				// Replace "__name__" in the prototype with the new index and then symfony uses this to correctly map the form fields in the 'post data'
				const newForm = prototype.replace(/__name__/g, index);
				// Injecting the newly generated form block at the bottom of the container
				container.insertAdjacentHTML('beforeend', newForm);
			});
		}

		// Add new Step form
		addForm('#add-step', '.collection-steps');
		// Add new External Link form
		addForm('#add-link', '.collection-links');
		// Add new External Link form
		addForm('#add-document', '.collection-documents');
	</script>
{% endblock %}
