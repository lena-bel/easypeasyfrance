{% extends "base.html.twig" %}
{% block header %}
	{% include "partials/admin-header.html.twig" %}
{% endblock %}

{% block body %}
	<main id="faq">
		<h1>FAQ</h1>
		<form class="search" method="get" action="{{ path('admin_faq') }}">
					<input name="search" type="text" placeholder="Search tasks..." class="search-bar"/>
					<a href="{{ path('new_faq') }}" class="button-clear">+ New FAQ</a>
				</form>

		<div class="table-container">
			<table>
				<thead>
					<tr>
						<th>Question</th>
						<th>Response</th>
						<th style="width: 8rem;">Actions</th>
					</tr>
				</thead>
				<tbody>
					{% for faq in faqs %}
						<tr>
							<td>{{ faq.question}}</td>

							<td>{{ faq.response}}</td>

							<td class="action">
								<a href="{{path('edit_faq', { 'id': faq.id })}}">edit <i class="material-icons">edit</i></a>
								
								<form id="delete-faq-{{ faq.id }}" action="{{path('delete_faq',{'id':faq.id})}}" method="POST" style="display:none">
									<input type="hidden" name="_token" value="{{csrf_token('delete'~ faq.id)}}">
								</form>
								<a href="#" onclick="event.preventDefault(); if(confirm('Are you sure you want to delete this faq?')) { document.getElementById('delete-faq-{{ faq.id }}').submit(); }" style="color: red;">Delete <i class="material-icons">delete</i></a>
							</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
	</main>
{% endblock %}
