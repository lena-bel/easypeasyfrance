{% extends "base.html.twig" %}
{% block header %}
	{% include "partials/admin-header.html.twig" %}
{% endblock %}

{% block body %}
	<main id="admin-dashboard" class="main-wrapper">

		<section class="cards summary-cards">
			<div class="summary-item">
				<h2>Total Users</h2>
				<p>{{ totalUsers }}</p>
			</div>
			<div class="summary-item">
				<h2>Active Users</h2>
				<p>{{ totalActiveUsers }}</p>
			</div>
			<div class="summary-item">
				<h2>Upcoming Appointments</h2>
				<p>{{totalAppointments}}</p>
			</div>
		</section>

		<section class="cards profile-section">
			<div class="user-list">
				<h2>Users by Profile</h2>
				<ul>
					{% for userProfile in totalUsersPerProfile %}
						<li>👤
							{{ userProfile.visaType|capitalize }}:
							{{ userProfile.total }}</li>
					{% else %}
						<li>No data</li>
					{% endfor %}
				</ul>
			</div>
		</section>
		<section class='piechart'>
			<div class="chart-container cards chart">
				<h2>User Distribution Chart</h2>
				<canvas id="userChart"></canvas>

			</div>
		</section>

		<section class="cards appointments">
			<h2>Upcoming Appointments</h2>
			{% if availableAppointments %}

				<ul>
					{% for apt in availableAppointments %}
						<li>
							<strong>{{apt.user.lastName}}
								{{apt.user.firstName}}</strong>
							—
							{{apt.appointmentSlot.date|date('Y-m-d')}}
							<strong>
								<i>{{apt.appointmentSlot.time|date('H:i')}}</i>
							</strong>
						</li>
					{% endfor %}

				</ul>
			{% else %}
				<h3>No appointments Today</h3>
			{% endif %}
		</section>


		<section class="cards quick-actions">
			<h2>Quick Actions</h2>
			<div class="quick-actions-buttons">
        <a href="{{ path('admin_task_new') }}" class='pri btn'>Add New Task</a>
				<a href="" class="sec btn">Schedule Appointment</a>
				<a href="{{path('users')}}" class="pri btn">View All Users</a>
				{# <a href="" class="sec btn">Send Notification</a> #}
			</div>
		</section>
		

	</main>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

	<script>
    const ctx = document.getElementById('userChart');
    const labels = {{ totalUsersPerProfile|map(p => p.visaType)|json_encode|raw }};
    const values = {{ totalUsersPerProfile|map(p => p.total)|json_encode|raw }};
    const userData = {
    labels: labels,
    datasets: [
    {
    label: 'User Profiles',
    data: values,
    backgroundColor: [
    '#C66B3D',
    '#D2BBA0',
    '#A8A69F',
    '#2E2E2E',
    '#FAF9F6'
    ],
    borderWidth: 1
    }
    ]
    };

    new Chart(ctx, {
    type: 'pie',
    data: userData,
    options: {
    plugins: {
    legend: {
    position: 'bottom'
    },
    title: {
    display: true,
    text: 'User Distribution by Profile'
    }
    }
    }
    });
	</script>


{% endblock %}
