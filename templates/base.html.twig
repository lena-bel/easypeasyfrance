<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="google-site-verification" content="AYTr70zhib6hRiEhewCeW0uSAjbIIxCY5cL_59Jj--E"/>

		<title>
			{% block title %}Easy Peasy France
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
		<link rel="icon" href="/images/website/favicon.png" type="image/png">

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
		{% block stylesheets %}
			<link rel="stylesheet" href="{{ asset('build/css/app.css') }}">
		{% endblock %}

	</head>
	<body style='display:flex;flex-direction:column; min-height:100vh; '> {% block header %}{% endblock %}
		<section
			style='flex:1;'>
			{# ✅ Add flash messages here so they appear everywhere #}
			<div id="flash-container">
				{% for label, messages in app.flashes %}
					{% for message in messages %}
						<div class="flash-message {{ label }}">
							{{ message }}
						</div>
					{% endfor %}
				{% endfor %}
			</div>
			{% include 'partials/_cookie_consent.html.twig' %}


			{% block body %}{% endblock %}
		</section>
		{% block footer %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
				{% if app.request.cookies.get('easy_peasy_consent') == 'accepted' %}
					<!-- Load optional scripts like analytics -->
					<script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXX"></script>
					<script>
						window.dataLayer = window.dataLayer || [];
function gtag() {
dataLayer.push(arguments);
}
gtag('js', new Date());
gtag('config', 'G-XXXXXX');
					</script>
				{% endif %}
			{% endblock %}
		{% endblock %}
	</body>
</html>
