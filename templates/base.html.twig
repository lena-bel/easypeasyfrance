<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:ital,wght@0,100..900;1,100..900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Work+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet"> {% block stylesheets %}{% endblock %}

		{% block javascripts %}
			{% block importmap %}
				{{ importmap('app') }}
			{% endblock %}
		{% endblock %}
	</head>
	<body>
		{% block header %}
			<nav class="header">
				
				{% if app.user %}
					<div>
						<a href="{{ path('task_index') }}" class="logo">Easy Peasy France</a>

					</div>
					<div class="links">
						<a href="{{ path('task_index') }}">To-Do</a>
						<a href="#">Messages</a>
						<a href="{{ path('posts_index') }}">Community Help</a>
						<a href="#">Appointments</a>
						<a href="#">Notifications</a>
						<a href="#">Settings</a>
					</div>
				{% else %}
					<div>
						<a href="{{ path('home') }}" class="logo">Easy Peasy France</a>

					</div>
					<div class="links">
						<a href="{{ path('about') }}">About</a>
						<a href="#">How it works</a>
						<a href="#">Testimonials</a>
						<a href="#">FAQ</a>
						<a href="#">Contact us</a>
					</div>
				{% endif %}
			</body>
		</body>
	</html>
</nav>{% endblock %}{% block body %}{% endblock %}{% block footer %}
<footer>
	<div class="footer-column">
		<h4>Easy Peasy France</h4>
		<ul>
			<li><a href="#">About</a></li>
			<li><a href="#">How it works</a></li>
			<li><a href="#">Testimonials</a></li>
		</ul>
	</div>
	<div class="footer-column">
		<h4>Help</h4>
		<ul>
			<li><a href="#">FAQ</a></li>
			<li><a href="#">Support</a></li>
			<li><a href="#">Contact us</a></li>
		</ul>
	</div>
	<div class="footer-column">
		<h4>Legal</h4>
		<ul>
			<li><a href="#">Terms of Use</a></li>
			<li><a href="#">Privacy Policy</a></li>
			<li><a href="#">Cookie Policy</a></li>
		</ul>
	</div>
	<div class="footer-column">
		<h4>Follow Us</h4>
		<ul>
			<li><a href="#">Instagram</a></li>
			<li><a href="#">LinkedIn</a></li>
			<li><a href="#">Facebook</a></li>
		</ul>
	</div>
	<div class="footer-bottom">
		&copy; 2025 Easy Peasy France. All rights reserved.
	</div>
</footer>{% endblock %}</body></html>
