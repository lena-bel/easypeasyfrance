{% extends "base.html.twig" %}
{% block header %}
	{% include "partials/user-header.html.twig" %}
{% endblock %}


{% block body %}
	<main id='appointment'>

		<div class='container'>
			<h1>My Appointments</h1>

			{% if existingAppointment %}
				<div class="appointment-card">
					<h2>You already have an appointment</h2>
					<p>📅
						<strong>Date:</strong>
						{{ existingAppointment.appointmentSlot.date|date('d M Y') }}</p>
					<p>⏰
						<strong>Time:</strong>
						{{ existingAppointment.appointmentSlot.time|date('H:i') }}</p>
					<p>You can only book another appointment once this one is completed or cancelled.</p>

					<form action="{{ path('appointment_cancel', {'id': existingAppointment.id}) }}" method="post" style="margin-top:1rem;">
						<button type="submit" class="cancel-btn">Cancel My Appointment <i class="material-icons" style="font-size: inherit; vertical-align: middle; position: relative; top: -1px; margin-left: 3px;"
>event_busy</i></button>
					</form>

				</div>

			{% else %}
				<h2 class="section-title">Available Slots</h2>

				<div class="calendar">
					{% for key, day in groupedSlots %}
						<div class="day-card">
							<button class="day-header" onclick="toggleSlots('{{ key }}')">
								<span>{{ day.date|date('l, d M Y') }}</span>
								<span id="arrow-{{ key }}">▼</span>
							</button>


							<div id="slots-{{ key }}" class="time-slots">
								{% for slot in day.slots %}
									<div class="time-slot" onclick="selectSlot(this,'{{ slot.date|date('Y-m-d') }}','{{ slot.time|date('H:i') }}','{{ slot.id }}')">
										{{ slot.time|date('H:i') }}
									</div>
								{% endfor %}
							</div>
						</div>
					{% else %}
						<p class="no-slots">No available slots at the moment.</p>
					{% endfor %}
				</div>


			</div>

			<div id="appointmentForm" class="hidden">
				{{form_start(form)}}
				{{ form_row(form.reason) }}
				{{ form_row(form.message) }}
				<input type="hidden" id="slotIdField" name="slot_id"/>

				{{form_end(form)}}
			</div>
		</div>

	{% endif %}
</div></main>
<script>
// document.addEventListener("turbo:load", function() {
function selectSlot(slotElement, date, time, slotId) {
const form = document.getElementById('appointmentForm');
if (form) 
form.classList.remove('hidden');



let slotIdInput = document.getElementById('slotIdField');
if (! slotIdInput) {
slotIdInput = document.createElement('input');
slotIdInput.type = 'hidden';
slotIdInput.name = 'slot_id';
slotIdInput.id = 'slotIdField';
form.appendChild(slotIdInput);
}
slotIdInput.value = slotId;

form.scrollIntoView({behavior: 'smooth', block: 'start'});

document.querySelectorAll('.time-slot').forEach(s => s.classList.remove('selected'));
slotElement.classList.add('selected');
}


function toggleSlots(dayKey) {
const slots = document.getElementById('slots-' + dayKey);
const arrow = document.getElementById('arrow-' + dayKey);
if (! slots || ! arrow) 
return;



if (slots.style.display === 'grid') {
slots.style.display = 'none';
arrow.textContent = '▼';
} else {
slots.style.display = 'grid';
arrow.textContent = '▲';
}

const cancelBtn = document.querySelector('.cancel-btn');
if (cancelBtn) {
cancelBtn.addEventListener('click', (e) => {
if (!confirm('Are you sure you want to cancel your appointment?')) {
e.preventDefault();
}
});
}

}
// })
</script>
{% endblock %}
{% block footer %}
{% include "partials/footer.html.twig" %}
{% endblock %}
