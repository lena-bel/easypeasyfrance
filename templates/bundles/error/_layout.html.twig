{# Base section layout for all error pages #}
{% extends 'base.html.twig' %}

{% block title %}{{ title|default('Oops! Something went wrong') }} | Easy Peasy France{% endblock %}

{% block body %}
<section id="epf-error">
  <div class="epf-error__card">
    {% if badge is defined %}
      <div class="epf-error__badge">{{ badge }}</div>
    {% endif %}

    <h1 class="epf-error__title">
      {{ heading|default('Oops!') }}
    </h1>

    {% if subheading is defined %}
      <p class="epf-error__subtitle">{{ subheading }}</p>
    {% endif %}

    {% if illustration is defined and illustration %}
      <div class="epf-error__image">
        {{ include(illustration) }}
      </div>
    {% endif %}

    <div class="epf-error__actions">
      <a class="epf-btn epf-btn--primary" href="{{ path('app_home') }}">Retour à l’accueil</a>

      {% if app.request is defined and app.request.headers.get('referer') %}
        <a class="epf-btn epf-btn--ghost" href="{{ app.request.headers.get('referer') }}">Page précédente</a>
      {% else %}
        <a class="epf-btn epf-btn--ghost" href="{{ path('app_faq') }}">Besoin d’aide ?</a>
      {% endif %}
    </div>

    
    {% if app.environment != 'prod' %}
      <div class="epf-error__meta">
        <small>
          Code: {{ status_code|default('—') }} • {{ status_text|default('—') }}
        </small>
      </div>
    {% endif %}
  </div>
</section>
{% endblock %}
