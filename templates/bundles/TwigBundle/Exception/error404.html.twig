{# <h1>OK</h1> #}
{% extends 'base.html.twig' %}

{% block title %}Page Not Found | EasyPeasyFrance{% endblock %}

{% block body %}
<div style="
    text-align: center;
    padding: 80px 20px;
    max-width: 600px;
    margin: 0 auto;
    color: #2E2E2E;
">
    <h1 style="font-size: 72px; margin-bottom: 10px; color: #C66B3D;">
        404
    </h1>

    <h2 style="font-size: 28px; margin-bottom: 20px;">
        Oops! This page doesn’t exist.
    </h2>

    <p style="font-size: 18px; color: #555;">
        The page you’re looking for might have been moved,
        deleted, or simply never existed.  
        Don’t worry — we’ll help you get back on track.
    </p>

    <div style="margin-top: 40px;">
        <a href="{{ path('home') }}" style="
            background-color: #C66B3D;
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 16px;
        ">
            Go back to Home
        </a>
    </div>

    <p style="margin-top: 25px; font-size: 14px; color: #888;">
        If you believe this is an error, you can contact our support team.
    </p>
</div>
{% endblock %}
