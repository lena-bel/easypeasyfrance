{% extends 'base.html.twig' %}

{% block title %}Something Went Wrong | EasyPeasyFrance{% endblock %}

{% block body %}
<div style="
    text-align: center;
    padding: 80px 20px;
    max-width: 600px;
    margin: 0 auto;
    color: #2E2E2E;
">
    <h1 style="font-size: 72px; margin-bottom: 10px; color: #C66B3D;">
        500
    </h1>

    <h2 style="font-size: 28px; margin-bottom: 20px;">
        Oops! Something went wrong on our side.
    </h2>

    <p style="font-size: 18px; color: #555;">
        This wasn't your fault.  
        We’re working to fix the problem as quickly as possible.  
        Please try again in a moment.
    </p>

    <div style="margin-top: 40px;">
        <a href="{{ path('home') }}" style="
            background-color: #C66B3D;
            color: white;
            padding: 12px 24px;
            border-radius: 8px;
            text-decoration: none;
            font-size: 16px;
        ">
            Return to Home
        </a>
    </div>

    <p style="margin-top: 25px; font-size: 14px; color: #888;">
        If you continue to experience this error, please contact our support team.
    </p>
</div>
{% endblock %}
