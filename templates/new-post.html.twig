{% extends "base.html.twig" %}
{% block body %}
<main id="new-post">
    <div class="form-container">
    <h1>Create a New Post</h1>
    <form action="#" method="post" enctype="multipart/form-data">
      <label for="title">Post Title</label>
      <input type="text" id="title" name="title"
             placeholder="Example: Help with CAF housing form" required />

      <label for="profile">Your Profile</label>
      <select id="profile" name="profile" required>
        <option value="" disabled selected>Select your profile</option>
        <option value="student">Student</option>
        <option value="family">Private &amp; Family Life</option>
        <option value="talent">Talent Passport</option>
        <option value="refugee">Refugee</option>
        <option value="worker">Worker</option>
      </select>

      <label for="content">Your Question or Experience</label>
      <textarea id="content" name="content"
                placeholder="Write your full question, concern, or experience..."
                required></textarea>

      <label for="image">Upload Image (optional)</label>
      <input type="file" id="image" name="image"
             accept="image/*" />

      <label for="tags">Tags (optional)</label>
      <input type="text" id="tags" name="tags"
             placeholder="e.g. CAF, housing, Lyon" />

      <div class="form-checkbox">
        <input type="checkbox" class="anonymous" name="anonymous" />
        <label for="anonymous">Post anonymously</label>
      </div>

      <button type="submit" class="submit-btn">Submit Post</button>
    </form>
  </div>
</main>

{% endblock %}