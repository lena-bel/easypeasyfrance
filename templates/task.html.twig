{% extends "base.html.twig" %}
{% block header %}
    {% include "partials/user-header.html.twig" %}
{% endblock %}
{# {% block stylesheets %}
	{{ knp_pagination_rel_links(tasks) }}
{% endblock %} #}
{% block body %}

	<main id="task">
	<h1>My Guide</h1>
		<form action="{{ path('task_index') }}" method="GET" class="section-one">
			<input type="search" name="searchbar" placeholder="Search..."/>
		</form>

		{% if tasks is empty %}
			<p>No tasks found.</p>

		{% else %}
			<section class="main-section">
				<div class="todo-list">
					{% for task in tasks %}
						<div class="card">
							<h3>{{task.title}}</h3>
							<div class="task-data">
								<p class="data">Last Updated : {{task.updatedAt|date('Y-m-d')}}</p>
							</div>
							<p class="task-desc">
								{{task.description}}
							</p>
							<div class="task-actions">
								<a href="{{ path('task-details', { id: task.id }) }}" class="btn">See details</a>
								{# <a href="#" class="btn">Finish</a> #}
							</div>
						</div>
					{% endfor %}
				</div>
			</section>
		{% endif %}
		{# <div class="navigation">
			{{ knp_pagination_render(tasks) }}
		</div> #}
	</main>

{% endblock %}
{% block footer %}
    {% include "partials/footer.html.twig" %}
{% endblock %}