{% extends "base.html.twig" %}
{% block body %}

	<main id="task">
		<form action="{{ path('task_index') }}" method="GET" class="section-one">
			<input type="search" name="searchbar" placeholder="Search..."/>
			<button type="submit">Search</button>
		</form>

		{% if tasks is empty %}
			<p>No tasks found.</p>

		{% else %}
			<section class="main-section">
				<div class="todo-list">
					{% for task in tasks %}
						<div class="card">
							<h3>{{task.title}}</h3>
							<div class="task-meta">Profil : Étudiant · Statut : En cours · Échéance : 15 juin 2025</div>
							<p class="task-desc">
								{{task.description}}
							</p>
							<div class="task-actions">
								<a href="{{ path('task_show', { id: task.id }) }}" class="btn">See details</a>
								<a href="#" class="btn">Finish</a>
							</div>
						</div>
					{% endfor %}
				</div>
			</section>
		{% endif %}
	</main>
{% endblock %}
