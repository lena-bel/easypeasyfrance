{% extends "base.html.twig" %}
{% block header %}
	{% include "partials/user-header.html.twig" %}
{% endblock %}
{% block body %}
	<main id="container">
		<div class="content" aria-label="Community Help posts">
			<div class="header">
				<p class="card">
					Welcome to the community help page! Here you can ask questions, share tips, and support fellow newcomers navigating life in France.
				</p>
				
			</div>
			<form class="search-bar" role="search" aria-label="Search community posts" method="get" action="{{ path('posts_search') }}">
			
				<input type="search" placeholder="Search posts by keyword…" aria-label="Search posts" name='q' value="{{ keyword|default('') }}"/>
				<a href="{{path('new-post')}}" class="post-button new-post" role="button">➕  &nbsp; ASK
				</a>
			</form>

			<ul class="posts-list">
				{% for post in posts %}
					<li>
						<h3 class="post-title">
							<a href="{{ path('post_detail', {id: post.id}) }}" class="post-title-link">
								{{post.title}}</a>
						</h3>
						<p class="post-excerpt">{{post.content}}</p>

						<div class="post-meta" data-date="{{ post.publicationDate|date('c') }}">
							<p>By{{post.user.firstName}}
								<span>-</span>
								<span class="time-ago"></span>
								<span>-</span>
								<a href="{{ path('post_detail', {id: post.id}) }}">{{post.commentsNumber}}
									comments
								</a>
								<span>-</span>
								<a href="{{ path('post_favorite', {id: post.id}) }}" class="favorite-btn">
								{% if app.user.favoritePosts.contains(post) %}
									<i class="fa-solid fa-heart favorite-icon" style="color: #C66B3D; font-size: 20px;"></i>
								{% else %}
									<i class="fa-regular fa-heart favorite-icon" style="color: black; font-size: 20px;"></i>
								{% endif %}
							</a>
							</p>
							

						</div>
					</li>
				{% endfor %}
			</ul>
		</div>
	</main>

	<script>
	// document.addEventListener("turbo:load", function() {
		let posts = document.querySelectorAll('.post-meta');
for (let i = 0; i < posts.length; i++) {
let currentPostMetaElement = posts[i];
let dateString = currentPostMetaElement.getAttribute('data-date');
if (! dateString) 
continue;



let date = new Date(dateString);
let differenceInMilliseconds = Date.now() - date.getTime();
let differenceInHours = Math.floor(differenceInMilliseconds / (1000 * 60 * 60));
let differenceInMinutes = Math.floor(differenceInMilliseconds / (1000 * 60));
let differenceInDays = Math.floor(differenceInHours / 24);
let differenceInMonths = Math.floor(differenceInDays / 30);
let differenceInYears = Math.floor(differenceInMonths / 12);
let text;
switch (true) {
case differenceInYears > 0: text = differenceInYears + ' years ago';
break;
case differenceInMonths > 0: text = differenceInMonths + ' months ago';
break;
case differenceInDays > 0: text = differenceInDays + ' days ago';
break;
case differenceInHours > 0: text = differenceInHours + ' hours ago';
break;
default: text = differenceInMinutes + ' minutes ago';
break;
}
currentPostMetaElement.querySelector('.time-ago').textContent = text;
// console.log(differenceInMilliseconds);
// console.log(differenceInMinutes);
// console.log(differenceInHours);

}
	// });


	</script>
{% endblock %}

{% block footer %}
	{% include "partials/footer.html.twig" %}
{% endblock %}
