{% extends "base.html.twig" %}
{% block header %}
	{% include "partials/user-header.html.twig" %}
{% endblock %}
{% block body %}
	<main id="container">
		<aside class="navbar">
			<h2>Filter Posts</h2>
			<form action="">
				<div class="filter-group">
					<label for="sort-posts-select">
						<strong>Sort Posts By</strong>
					</label>
					<select id="sort-posts-select" name="sort-posts">
						<option value="recent" selected>Most Recent</option>
						<option value="commented">Most Commented</option>
						<option value="liked">Most Liked</option>
					</select>
				</div>
				<div class="filter-group">
					<label>
						<strong>By User Profile</strong>
					</label>
					<div>
						<input type="checkbox" id="profile-all" value="all" checked>
						<label for="profile-all">All profiles</label>
					</div>
					{% for visa in visas %}
						<div>
							<input type="checkbox" id="profile-{{visa.name}}" value="all">
							<label for="{{visa.name}}">{{visa.name}}</label>
						</div>
					{% endfor %}
				</div>
				<div class="buttons">
					<a href="#" class="post-button filter" role="button">Filter</a>
					<a href="#" class="post-button reset" role="button">Reset</a>
				</div>

			</form>
		</aside>
		<div class="content" aria-label="Community Help posts">
			<div class="header">
				<p class="card">
					Welcome to the community help page! Here you can ask questions, share tips, and support fellow newcomers navigating life in France.
				</p>
				<a href="{{path('new-post')}}" class="post-button new-post" role="button">Create New Post</a>
			</div>
			<form class="search-bar" role="search" aria-label="Search community posts">
				<input type="search" placeholder="Search posts by keyword…" aria-label="Search posts"/>
			</form>

			<div class="categories-filter" role="list" aria-label="Filter posts by categories">
				<button type="button" class="active">All</button>
				<button type="button">Housing</button>
				<button type="button">Health</button>
				<button type="button">Legal</button>
				<button type="button">Education</button>
				<button type="button">Employment</button>
				<button type="button">Other</button>
			</div>
			<ul class="posts-list">
				{% for post in posts %}
					<li>
						<h3 class="post-title">
							<a href="#" class="post-title-link">
								{{post.title}}</a>
						</h3>
						<p class="post-excerpt">{{post.content}}</p>
						<div class="post-meta" data-date="{{ post.publicationDate|date('c') }}">
							<p>By{{post.user.firstName}} - <span class="time-ago"></span> - {{post.commentsNumber}}comments - <i class="fa-heart favorite-icon far "></i></p>
							
						</div>
					</li>
				{% endfor %}
			</ul>
		</div>
	</main>

	<script>
		let posts = document.querySelectorAll('.post-meta');
for (let i = 0; i < posts.length; i++) {
let currentPostMetaElement = posts[i];
let dateString = currentPostMetaElement.getAttribute('data-date');
if (! dateString) 
continue;


let date = new Date(dateString);
let differenceInMilliseconds = Date.now() - date.getTime();
let differenceInHours = Math.floor(differenceInMilliseconds / (1000 * 60 * 60));
let differenceInMinutes = Math.floor(differenceInMilliseconds / (1000 * 60));
let text = differenceInHours > 0 ? differenceInHours + 'hours ago' : differenceInMinutes + 'minutes ago';
currentPostMetaElement.querySelector('.time-ago').textContent = text;
// console.log(differenceInMilliseconds);
// console.log(differenceInMinutes);
// console.log(differenceInHours);

}
	</script>
{% endblock %}

{% block footer %}
	{% include "partials/footer.html.twig" %}
{% endblock %}
